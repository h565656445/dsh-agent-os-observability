{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://local.hermes-harness/schemas/agent_os_observability_spec.schema.json",
  "title": "Hermes Agent OS Observability Specification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observation_key", "subject", "evidence_roots", "budgets", "stages"],
  "properties": {
    "schema_version": { "const": "0.1" },
    "observation_key": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{2,63}$" },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "subject_id", "contract_path", "contract_sha256"],
      "properties": {
        "kind": { "enum": ["agent_os_task", "worker_job", "graph", "project_task"] },
        "subject_id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{2,127}$" },
        "contract_path": { "type": "string", "minLength": 1 },
        "contract_sha256": { "type": "string", "pattern": "^[A-F0-9]{64}$" }
      }
    },
    "evidence_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "required": ["currency", "duration_ms", "model_calls", "input_tokens", "output_tokens", "cost_microunits"],
      "properties": {
        "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
        "duration_ms": { "type": "integer", "minimum": 0, "maximum": 1000000000000000 },
        "model_calls": { "type": "integer", "minimum": 0, "maximum": 1000000000000000 },
        "input_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000000000 },
        "output_tokens": { "type": "integer", "minimum": 0, "maximum": 1000000000000000 },
        "cost_microunits": { "type": "integer", "minimum": 0, "maximum": 1000000000000000 }
      }
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stage_id", "depends_on", "quality_gates"],
        "properties": {
          "stage_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
          "depends_on": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" }
          },
          "quality_gates": {
            "type": "array",
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["gate_id", "metric", "unit", "operator", "threshold", "evidence_required"],
              "properties": {
                "gate_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
                "metric": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$" },
                "unit": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._%/-]{0,31}$" },
                "operator": { "enum": ["gte", "lte", "eq"] },
                "threshold": { "type": "integer", "minimum": -1000000000000000, "maximum": 1000000000000000 },
                "evidence_required": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
